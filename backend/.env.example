DATABASE_URL=postgresql://postgres:tu_contrasena@localhost:5432/rastreo_py
MAIL_USER=tu-cuenta@gmail.com
MAIL_PASS=contraseña_de_aplicacion_de_16_caracteres
# Opcional: enviar por la API HTTPS de Brevo en vez de SMTP (obligatorio en Render,
# que bloquea SMTP). Si BREVO_API_KEY está vacía, se usa SMTP con MAIL_USER/MAIL_PASS.
BREVO_API_KEY=
# Remitente (verificado en Brevo). Si está vacío, se usa MAIL_USER.
MAIL_FROM=
JWT_SECRET=reemplaza_por_un_secreto_aleatorio_de_al_menos_32_caracteres
ADMIN_IDENTIFICADOR=administrador@gmail.com
ADMIN_PASSWORD=reemplaza_por_una_contrasena_segura
APP_URL=http://localhost:3000
VENTANA_LOCALIZADOS_HORAS=24
# Días tras los que un caso localizado se cierra solo: queda CERRADO, se apaga su
# geocerca y el cambio va al historial. Sigue contando como encontrado. Por
# defecto 7. (La ficha pública se retira antes, a las VENTANA_LOCALIZADOS_HORAS.)
LIMITE_CIERRE_LOCALIZADO_DIAS=7
NODE_ENV=development
# Proxies delante de la app (Render, túnel de Cloudflare). Verificar al desplegar
# con GET /api/admin/diagnostico-red (sesión de administrador).
TRUST_PROXY_HOPS=1
# Consultas públicas por minuto y por IP (en un evento muchos comparten IP).
LIMITE_LECTURA_PUBLICA_POR_MINUTO=3000
# Alertas de zona (160 km): horas que un mismo reportante debe esperar para que
# otro reporte suyo genere una alerta temprana. 0 = sin límite.
LIMITE_ALERTA_TEMPRANA_HORAS=24
# Si una persona recibiría más alertas tempranas por push que esto en una hora,
# las siguientes llegan en un solo aviso agrupado. 0 = no agrupar.
LIMITE_PUSH_TEMPRANAS_POR_HORA=3
# Notificaciones Web Push. Generar el par con: npx web-push generate-vapid-keys
# (desde backend/). La privada es un secreto. Sin las tres, el push queda
# desactivado y las alertas llegan solo al centro de notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable para los servicios push: mailto:correo o una URL https.
VAPID_SUBJECT=mailto:tu-cuenta@gmail.com
